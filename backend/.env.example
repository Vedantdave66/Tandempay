# Local development (SQLite — no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./tandempay.db

# Auth
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin
ADMIN_SECRET=change-me-to-a-random-admin-secret

# Sentry — leave empty to disable. Get your DSN from sentry.io after creating a Python project.
# On Vercel: set SENTRY_DSN=https://... and ENVIRONMENT=production in project env vars.
SENTRY_DSN=
ENVIRONMENT=development

# Logging — DEBUG for local development, INFO for production.
# Valid: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
