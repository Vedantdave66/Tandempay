{"nodes": [{"id": "system_evolution_doc", "label": "System Evolution Document", "file_type": "document", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sysevo_idempotency_redesign", "label": "Idempotency Infrastructure Redesign", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "UniqueConstraint is the database-level safety net. Application-level SELECT before INSERT is for performance only; correctness requires the DB constraint under MVCC."}, {"id": "sysevo_row_lock_sorted", "label": "Sorted-Order Row Lock Strategy (Deadlock Prevention)", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents deadlocks by construction rather than detection/recovery. All requesters sort by user UUID before acquiring locks, ensuring consistent acquisition order."}, {"id": "sysevo_9step_payment_protocol", "label": "9-Step Payment Protocol (TOCTOU Fix)", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Step 3.5 re-fetches PaymentRequest with FOR UPDATE after acquiring user locks, closing the TOCTOU window between initial status check and lock acquisition."}, {"id": "sysevo_double_entry_ledger", "label": "Double-Entry Ledger Design", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "wallet_balance is a cache; WalletTransaction table is source of truth. pre_validate_balance and validate_balance_integrity enforce invariant before and after mutations."}, {"id": "sysevo_decimal_upgrade", "label": "Float to Numeric(12,2) Decimal Precision Upgrade", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sysevo_test_sqlite_stage1", "label": "Stage 1: Sequential SQLite Tests", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove logic correctness but cannot validate concurrency safety. FOR UPDATE is no-op on SQLite; race conditions impossible to trigger sequentially."}, {"id": "sysevo_test_pg_stage2", "label": "Stage 2: PostgreSQL Concurrency Tests (asyncio.gather)", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "True parallelism proves row-level locks actually block, UniqueConstraint races actually fire, and wallet drain never goes negative."}, {"id": "sysevo_test_failure_stage3", "label": "Stage 3: Failure Injection Tests", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves crash-after-commit returns cached response, partial failures result in complete rollback, retry storms cannot penetrate idempotency barrier."}, {"id": "sysevo_conservation_invariant", "label": "Conservation of Money Invariant", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "assert_conservation_of_money checks total_before == total_after for every transfer. Invariant-based testing catches classes of bugs rather than specific values."}, {"id": "sysevo_flush_vs_commit", "label": "Flush vs Commit Pattern", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "db.flush() writes SQL within the transaction; db.commit() makes it permanent. Exception after flush but before commit results in complete rollback. Enables write-invariant-check-commit atomic pattern."}, {"id": "sysevo_reconciliation_service", "label": "Reconciliation Service (Safety Net)", "file_type": "rationale", "source_file": "docs/system_evolution.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists as a safety net; invariant checks should prevent drift entirely. If reconciliation finds a discrepancy, it signals a bug in transaction logic requiring investigation."}], "edges": [{"source": "system_evolution_doc", "target": "sysevo_idempotency_redesign", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system_evolution.md", "source_location": null, "weight": 1.0}, {"source": "system_evolution_doc", "target": "sysevo_row_lock_sorted", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system_evolution.md", "source_location": null, "weight": 1.0}, {"source": "system_evolution_doc", "target": "sysevo_9step_payment_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system_evolution.md", "source_location": null, "weight": 1.0}, {"source": "system_evolution_doc", "target": "sysevo_double_entry_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/system_evolution.md", "source_location": null, "weight": 1.0}, {"source": "system_evolution_doc", "target": "sysevo_decimal_upgrade", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file":